#!/bin/sh
# livesys-hyprland: Hyprland setup for livesys

rm /etc/greetd/config.toml
tee /etc/greetd/config.toml <<'EOF'
[general]
service = "greetd-spawn"

[terminal]
vt = 1

[default_session]
command = "dms-greeter --command hyprland --cache-dir /var/cache/dms-greeter"
user = "greeter"

[initial_session]
command = "Hyprland"
user = "liveuser"
EOF
systemctl restart greetd

echo "echo 'Please type liveinst and press Enter to start the installer'" >> /home/liveuser/.bashrc
chown --recursive liveuser:liveuser /home/liveuser/